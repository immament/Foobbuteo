.online-users-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
}
.online-users-overlay {
  position: absolute;
  left: 4%;
  right: 4%;
  top: 4%;
  bottom: 4%;
  font-size: 24px;
}
.user-list-content,
.user-list,
#roomMessagesContent,
#roomUsersContent {
  flex-grow: 1;
  min-height: 0;
}
.user-list-hidden {
  display: none;
}
.user-list-header,
.user-list-actions,
.room-user-tabs {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.user-list-header {
  justify-content: space-between;
}
.user-list-row-header {
  flex-grow: 1;
}

.room-user-tabs .btn-default {
  font-size: 12px;
  padding: 3px 6px;
  flex-shrink: 1;
  margin: 2px;
}
#MessagePanel #MatchReportHeading {
  display: none;
}
.user-list-name {
  flex-grow: 0;
  white-space: normal;
  -unity-font-style: bold;
}
.user-list-row-title {
  flex-grow: 1;
  flex-direction: row;
  align-items: flex-end;
  flex-wrap: wrap;
}

.online-users-overlay .user-list-name {
  font-size: 28px;
}
.online-users-overlay .user-list-identifiers,
.online-users-overlay .user-list-status {
  font-size: 20px;
}
.online-users-overlay .btn-default {
  font-size: 24px;
}
.user-list-row {
  padding: 8px;
  margin-bottom: 6px;
  background-color: rgb(35, 47, 61);
  border-radius: 4px;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  flex-grow: 1;
}
.narrow-screen .user-list-row {
  flex-direction: column;
}

.user-list-identifiers,
.user-list-status {
  white-space: normal;
  font-size: 12px;
  color: rgb(175, 189, 204);
  margin-bottom: 4px;
}

.user-shirt {
  width: 32px;
  height: 32px;
  margin-left: 4px;
  align-items: center;
  justify-content: center;
  -unity-background-scale-mode: scale-to-fit;
}
.user-shirt-number {
  -unity-font-style: bold;
  font-size: 12px;
  margin: 0;
  padding: 4px 0 0 0;
}

#usersList .unity-list-view__item:hover {
  background-color: transparent;
}
#usersList .unity-list-view__item:hover .user-list-row {
  background-color: rgb(52, 92, 130);
}
