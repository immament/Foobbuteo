<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="user-list" src="UserListView.tmpl.uxml" />
    <ui:Style src="../Common.style.uss" />
    <ui:VisualElement name="onlineUsersOverlay" class="online-users-overlay user-list-hidden fbt-card fbt-theme-primary">
        <ui:VisualElement class="fbt-card-header">
            <ui:Label text="ONLINE USERS" class="fbt-card-title user-list-title" />
            <ui:Button name="closeOnlineUsersButton" tooltip="Close" class="fbt-card-close">
                <ui:VisualElement class="fbt-card-close-icon" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement class="fbt-card-content user-list-content">
            <ui:VisualElement class="fbt-card-decoration" picking-mode="Ignore" />
            <ui:Instance template="user-list" class="user-list-content fbt-card-body" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
