#list-entry {
  flex-grow: 0;
  flex-shrink: 0;
  padding: 8px;
  margin: 4px;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  min-width: 0;
}
#main-view .unity-collection-view__item--selected > #list-entry {
  background-color: var(--color-primary-active);
}
#list-entry .unity-label {
  font-size: 14px;
  margin: 0;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
#list-entry .list-entry__team-name {
  font-size: 16px;
  -unity-font-style: bold;
}
#list-entry__names-col {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 160px;
  min-width: 0;
}
.lobby-game-row__metadata {
  flex-direction: row;
  flex-grow: 1;
  flex-shrink: 0;
  min-width: 0;
  flex-basis: 230px;
}
.lobby-game-row__metadata > .list-entry__col {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  min-width: 0;
  justify-content: center;
  padding: 0 4px;
}
#list-entry #list-entry__id-col {
  flex-grow: 1;
}
#list-entry #list-entry__date-col {
  flex-grow: 1.5;
}
#list-entry__status-col .unity-label {
  -unity-text-align: middle-right;
}
#main-view.narrow-screen #list-entry {
  flex-direction: column;
  flex-wrap: nowrap;
  align-items: stretch;
}
#main-view.narrow-screen #list-entry__names-col {
  flex-basis: auto;
}
#main-view.narrow-screen .lobby-game-row__metadata {
  flex-basis: auto;
  margin-top: 6px;
}
