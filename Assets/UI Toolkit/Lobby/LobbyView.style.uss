:root {
  --panel-bg: rgb(28, 32, 40);
  --panel-border: rgb(55, 65, 85);
  --text-color: rgb(240, 245, 255);
  --color-primary: rgb(45, 125, 255);
  --color-primary-hover: rgb(65, 145, 255);
  --color-primary-active: rgb(30, 105, 220);
  --color-secondary: rgb(52, 58, 68);
  --color-secondary-hover: rgb(35, 40, 46);
  --color-secondary-active: rgb(96, 105, 119);
}

#session-loading,
.connection-problem {
  display: none;
  flex-grow: 1;
  justify-content: center;
  align-items: center;
  color: rgb(240, 245, 255);
}

.connection-problem__message {
  white-space: normal;
  max-width: 440px;
  margin: 12px;
}

.profile-menu {
  display: none;
  padding: 8px;
  background-color: rgb(28, 32, 40);
}

.profile-menu__toggle {
  min-height: 36px;
  font-size: 16px;
  color: var(--text-color);
  background-color: transparent;
  border-width: 0;
  margin: 0;
  padding: 6px 10px;
}

#main-view__lobby {
  flex-grow: 1;
  display: none;
}

.lobby-login-scroll {
  flex-grow: 1;
  min-height: 0;
  display: none;
  padding: 8px;
}

.lobby-login-scroll .unity-scroll-view__content-container {
  flex-grow: 1;
  flex-shrink: 0;
  justify-content: center;
}

#main-view__main-container {
  flex-direction: row;
  flex-grow: 1;
  min-height: 0;
}

#main-view.narrow-screen #main-view__main-container {
  flex-direction: column;
}

#main-view__left-container {
  flex-basis: 0;
  flex-grow: 55;
  min-width: 0;
  min-height: 0;
}

#main-view.narrow-screen #main-view__left-container {
  flex-basis: 0;
  flex-grow: 1;
}

#main-view__game-list {
  flex-grow: 1;
  min-height: 0;
}

#main-view__info {
  flex-shrink: 0;
  flex-grow: 0;
  flex-basis: auto;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}

.web-gl #main-view__info {
  padding-right: 100px;
}

#main-view__info #info__tools {
  flex-direction: row;
  align-items: center;
  flex-grow: 1;
  justify-content: flex-end;
  flex-wrap: wrap;
}
#main-view__info #info__tools #login-logout {
  background-color: #40454d;
}

#main-view.narrow-screen #main-view__info {
  flex-direction: column;
  flex-basis: auto;
  padding-right: 16px;
}

#main-view.narrow-screen #info__tools {
  flex-wrap: wrap;
}
#main-view.narrow-screen #info__tools > .ft__btn--primary {
  padding: 8px 6px;
  min-height: auto;
}

#main-view .unity-collection-view__item {
  background-color: transparent;
}

#main-view .unity-list-view__item-content {
}

#main-view .unity-collection-view__item:hover {
  background-color: transparent;
}

#main-view .unity-collection-view__item--selected {
  background-color: transparent;
}

#main-view__right-container {
  flex-grow: 45;
  flex-basis: 0;
  min-width: 0;
  min-height: 0;
}

#main-view.narrow-screen #main-view__right-container {
  flex-grow: 1;
}

#main-view #details-container__game-data {
  margin-bottom: 8px;
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 0;
  max-height: 300px;
}

#main-view.narrow-screen #details-container__game-data {
  align-self: stretch;
}

.details-container__row {
  min-height: 24px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
  min-width: 0;
  flex-wrap: wrap;
}

.details-container__label {
  flex-grow: 1;
  margin-right: 8px;
  flex-shrink: 1;
  min-width: 0;
  white-space: normal;
  color: rgb(185, 195, 215);
}

.details-container__value {
  flex-shrink: 1;
  min-width: 0;
  white-space: normal;
  -unity-font-style: bold;
  -unity-text-align: middle-right;
}

#main-view.narrow-screen .details-container__label {
  flex-basis: auto;
}

#main-view.narrow-screen .details-container__value {
  padding-left: 8px;
}

.details-container__game-name-row {
  margin-bottom: 8px;
  padding-bottom: 12px;
  border-bottom-width: 1px;
  border-bottom-color: var(--panel-border);
}

.details-container__game-name-row .details-container__label {
  -unity-font-style: bold;
}

.ft__panel--default {
  background-color: var(--panel-bg);
  border-width: 1px;
  border-color: var(--panel-border);
  border-radius: 10px;
  padding: 10px;
  margin: 8px;
  flex-direction: column;
  color: var(--text-color);
}

#main-view.narrow-screen {
  padding: 2px;
}

#main-view.narrow-screen .ft__panel--default {
  margin: 2px;
}

.ft__btn--primary,
.ft__btn--secondary {
  min-height: 40px;
  font-size: 16px;
  white-space: normal;
  border-width: 0;
  border-radius: 6px;
  padding-left: 16px;
  padding-right: 16px;
  -unity-font-style: bold;
  transition-property: background-color;
  transition-duration: 0.15s;
}

.ft__btn--primary {
  background-color: var(--color-primary);
  color: var(--text-color);
}

.ft__btn--primary:hover {
  background-color: var(--color-primary-hover);
  scale: 1.01;
}

.ft__btn--primary:active {
  background-color: var(--color-primary-active);
  scale: 0.99;
}

.ft__btn--primary:disabled {
  background-color: rgb(70, 75, 85);
  color: rgb(140, 145, 155);
}

.ft__btn--secondary {
  background-color: var(--color-secondary);
  color: var(--text-color);
}
.ft__btn--secondary:hover {
  background-color: var(--color-secondary-hover);
  scale: 1.01;
}
.ft__btn--secondary:active {
  background-color: var(--color-secondary-active);
  scale: 0.99;
}
.ft__btn--secondary:disabled {
  background-color: rgb(70, 75, 85);
  color: rgb(140, 145, 155);
}

.lobby-toast-container .toast-alert {
  font-size: 16px;
  -unity-font-style: bold;
}

#main-view__info #profile-menu-toggle {
  white-space: normal;
}

#main-view__details-container {
  flex-grow: 1;
  min-height: 0;
}
.lobby-details__actions {
  flex-shrink: 0;
}
#main-view.lobby--short .lobby-details__actions {
  flex-direction: row;
}
.lobby-details__actions > .unity-button {
  flex-grow: 1;
  min-width: 0;
  font-size: 16px;
}

#main-view.narrow-screen .lobby-details__actions > .unity-button {
  max-width: 400px;
  padding: 8px 6px;
  min-height: auto;
  margin-bottom: 4px;
}

#main-view.lobby--short .ft__panel--default {
  padding: 6px;
  margin: 2px;
}
#main-view.lobby--short #main-view__info {
  padding: 4px;
}
#main-view .online-users-overlay {
  font-size: 16px;
}
#main-view .user-list-title,
#main-view .online-users-overlay .user-list-name {
  font-size: 20px;
}
#main-view .online-users-overlay .user-list-identifiers,
#main-view .online-users-overlay .user-list-status {
  font-size: 14px;
}
#main-view .online-users-overlay .btn-default {
  font-size: 16px;
  min-height: 44px;
  white-space: normal;
}
#main-view .user-list-actions {
  flex-wrap: wrap;
}
