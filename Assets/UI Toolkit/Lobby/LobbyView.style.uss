#session-loading,
.connection-problem {
  display: none;
  flex-grow: 1;
  justify-content: center;
  align-items: center;
  color: rgb(240, 245, 255);
}

.connection-problem__message {
  white-space: normal;
  max-width: 440px;
  margin: 12px;
}

.profile-menu {
  display: none;
  padding: 8px;
  background-color: var(--fbt-panel-background);
}

#profile-menu-toggle {
  -unity-font-definition: none;
  min-height: 36px;
  font-size: 22px;
  white-space: normal;
}

#main-view__lobby {
  flex-grow: 1;
  display: none;
}

.lobby-login-scroll {
  flex-grow: 1;
  min-height: 0;
  display: none;
  padding: 8px;
}

.lobby-login-scroll .unity-scroll-view__content-container {
  flex-grow: 1;
  flex-shrink: 0;
  justify-content: center;
}

#main-view__main-container {
  flex-direction: row;
  flex-grow: 1;
  min-height: 0;
}

#main-view.narrow-screen #main-view__main-container {
  flex-direction: column;
}

#main-view__left-container {
  flex-basis: 0;
  flex-grow: 55;
  min-width: 0;
  min-height: 0;
}

#main-view.narrow-screen #main-view__left-container {
  flex-basis: 0;
  flex-grow: 1;
}

#main-view__game-list {
  flex-grow: 1;
  min-height: 0;
}

#main-view__info {
  flex-shrink: 0;
  flex-grow: 0;
  flex-basis: auto;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  background-color: var(--fbt-panel-background);
  padding: 8px;
}

.web-gl #main-view__info {
  padding-right: 100px;
}

#main-view__info #info__tools {
  flex-direction: row;
  align-items: center;
  flex-grow: 1;
  justify-content: flex-end;
  flex-wrap: wrap;
}
#main-view.narrow-screen #main-view__info {
  flex-direction: column;
  flex-basis: auto;
  padding-right: 8px;
}

#main-view.narrow-screen #info__tools {
  flex-wrap: wrap;
}
#main-view.narrow-screen #info__tools > .fbt-btn {
  padding: 8px 6px;
  min-height: 44px;
}

#main-view .unity-collection-view__item {
  background-color: transparent;
}

#main-view .unity-collection-view__item:hover {
  background-color: transparent;
}

#main-view .unity-collection-view__item--selected {
  background-color: transparent;
}

#main-view__right-container {
  flex-grow: 45;
  flex-basis: 0;
  min-width: 0;
  min-height: 0;
}

#main-view.narrow-screen #main-view__right-container {
  flex-grow: 1;
}

#main-view #details-container__game-data {
  margin-bottom: 8px;
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 0;
}

#main-view.narrow-screen #details-container__game-data {
  align-self: stretch;
}

.details-container__row {
  min-height: 24px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
  min-width: 0;
  flex-wrap: wrap;
}

.details-container__label {
  flex-grow: 1;
  margin-right: 8px;
  flex-shrink: 1;
  min-width: 0;
  white-space: normal;
  color: var(--fbt-text-muted);
}

.details-container__value {
  flex-shrink: 1;
  min-width: 0;
  white-space: normal;
  -unity-font-style: bold;
  -unity-text-align: middle-right;
}

#main-view.narrow-screen .details-container__label {
  flex-basis: auto;
}

#main-view.narrow-screen .details-container__value {
  padding-left: 8px;
}

.details-container__game-name-row {
  margin-bottom: 8px;
  padding-bottom: 12px;
  border-bottom-width: 1px;
  border-bottom-color: var(--fbt-divider);
}

.details-container__game-name-row .details-container__label {
  -unity-font-style: bold;
}

.lobby-toast-container .toast-alert {
  font-size: 16px;
  -unity-font-style: bold;
}

#main-view__details-container {
  flex-grow: 1;
  min-height: 0;
}
.lobby-details__actions {
  flex-shrink: 0;
  flex-direction: row;
}
.lobby-details__actions > .unity-button {
  flex-grow: 1;
  min-width: 0;
  font-size: 22px;
}

#main-view.narrow-screen .lobby-details__actions > .unity-button {
  max-width: 400px;
  padding: 8px 6px;
  min-height: 44px;
  margin-bottom: 4px;
}

#main-view.lobby--short .lobby-panel {
  margin: 2px;
}
#main-view.lobby--short #main-view__info {
  padding: 4px;
}
#main-view .online-users-overlay {
  font-size: 16px;
}
#main-view .online-users-overlay .user-list-name {
  font-size: 20px;
}
#main-view .online-users-overlay .user-list-identifiers,
#main-view .online-users-overlay .user-list-status {
  font-size: 14px;
}
#main-view .online-users-overlay .btn-default {
  font-size: 16px;
  min-height: 44px;
  white-space: normal;
  -unity-font-definition: var(--fbt-font-button);
  -unity-font-style: normal;
  background-color: var(--fbt-button-background);
  border-color: var(--fbt-button-border);
  color: var(--fbt-button-text);
}
#main-view .user-list-actions {
  flex-wrap: wrap;
}

.lobby-panel {
  margin: 8px;
}
.lobby-panel__content {
  flex-grow: 1;
}
#info__tools > .fbt-btn {
  margin: 4px;
  font-size: 22px;
}
#main-view.narrow-screen .lobby-panel {
  margin: 2px;
}
#main-view.narrow-screen .lobby-panel .fbt-card-title,
#main-view.narrow-screen .online-users-overlay .fbt-card-title {
  font-size: 27px;
  padding-left: 16px;
  padding-right: 16px;
}
#main-view.narrow-screen .lobby-panel .fbt-card-body {
  padding-left: 10px;
  padding-right: 10px;
}
#main-view.narrow-screen .lobby-details__actions {
  padding: 8px;
}
#main-view.lobby--short .lobby-panel .fbt-card-header,
#main-view.lobby--short .online-users-overlay .fbt-card-header {
  height: 42px;
  min-height: 42px;
}
#main-view.lobby--short .lobby-panel .fbt-card-title,
#main-view.lobby--short .online-users-overlay .fbt-card-title {
  font-size: 26px;
  padding-top: 4px;
  padding-bottom: 4px;
}
#main-view .online-users-overlay .fbt-card-close {
  min-height: 44px;
}
#main-view .online-users-overlay .user-list-row {
  background-color: var(--fbt-field-background);
  border-width: 1px;
  border-color: var(--fbt-divider);
}
#main-view .online-users-overlay .btn-default:hover:enabled {
  background-color: var(--fbt-button-hover);
}
#main-view .online-users-overlay .btn-default:active:enabled {
  background-color: var(--fbt-button-active);
}
