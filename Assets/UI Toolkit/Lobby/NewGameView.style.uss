.new-game-template,
.new-game-modal {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.new-game-modal {
  display: none;
  background-color: rgba(0, 0, 0, 0.35);
  justify-content: center;
  align-items: center;
  padding: 16px;
}

.new-game-dialog {
  width: 650px;
  max-width: 100%;
  max-height: 100%;
  flex-shrink: 1;
}

.new-game-scroll {
  flex-shrink: 1;
}
.new-game-error {
  color: #ffa59b;
  white-space: normal;
  font-size: 16px;
  margin: 0;
}
#new-game-create {
  min-width: 240px;
}

#main-view.narrow-screen .new-game-modal {
  padding: 12px;
}
#main-view.narrow-screen .new-game-dialog .fbt-card-title {
  font-size: 27px;
  padding-left: 16px;
  padding-right: 16px;
}
#main-view.narrow-screen .new-game-dialog .fbt-card-body {
  padding-left: 16px;
  padding-right: 16px;
}
#main-view.narrow-screen #new-game-fields > .fbt-form-row {
  flex-direction: column;
  align-items: stretch;
}
#main-view.narrow-screen .new-game-dialog .fbt-form-label,
#main-view.narrow-screen
  #new-game-fields
  > .fbt-form-row
  > .unity-base-field__label {
  width: auto;
  margin-bottom: 5px;
}
#main-view.narrow-screen .new-game-actions {
  padding: 12px 16px 14px;
}
#main-view.narrow-screen .new-game-actions .fbt-btn {
  min-width: 0;
  margin-left: 8px;
  padding-left: 10px;
  padding-right: 10px;
  font-size: 22px;
  flex-shrink: 1;
}
#main-view.narrow-screen #new-game-create {
  flex-grow: 1;
  padding-left: 34px;
  padding-right: 34px;
}
#main-view.narrow-screen #new-game-create .fbt-btn-icon {
  right: 6px;
  width: 26px;
  height: 26px;
}

#main-view.lobby--short .new-game-modal {
  padding: 8px;
}
#main-view.lobby--short .new-game-dialog .fbt-card-header {
  height: 42px;
  min-height: 42px;
}
#main-view.lobby--short .new-game-dialog .fbt-card-title {
  font-size: 26px;
  padding-top: 4px;
  padding-bottom: 4px;
}
#main-view.lobby--short #new-game-fields > .fbt-form-row {
  min-height: 38px;
  padding-top: 3px;
  padding-bottom: 3px;
}
#main-view.lobby--short .new-game-actions {
  padding-top: 8px;
  padding-bottom: 10px;
}
