.ft-login {
  align-self: center;
  width: 100%;
  max-width: 440px;
  margin: 0;
  flex-shrink: 0;
  font-size: 16px;
}

#remember-login,
#login-retry {
  display: none;
}

.fbt-form-row.ft-login__field.unity-text-field {
  margin-bottom: 10px;
  flex-direction: column;
  align-items: stretch;
  border-width: 0;
}
#main-view.lobby--short .fbt-form-row.ft-login__field.unity-text-field {
  margin-bottom: 5px;
  flex-direction: row;
}

.fbt-form-row.ft-login__field.unity-toggle .unity-toggle__checkmark {
  margin-right: 10px;
}

.fbt-form-row.ft-login__field > .unity-base-field__label {
  margin-bottom: 5px;
}
.fbt-form-row.ft-login__field:focus:enabled > .unity-base-field__label {
  color: #bac5c9;
  /* -unity-font-style: bold; */
}

.fbt-form-row.ft-login__field .unity-text-field__input {
  min-height: 36px;
  flex-grow: 1;
  align-self: stretch;
}

.ft-login__status {
  white-space: normal;
  color: var(--fbt-text-muted);
  margin-bottom: 10px;
}

.ft-login__button {
  margin-bottom: 6px;
}
#main-view.lobby--short .ft-login__button {
  padding: 7px 16px;
}

.ft-login__signup-panel {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  font-size: 14px;
  margin-top: 8px;
  flex-wrap: wrap;
  padding: 0 16px 16px;
}

.text-link {
  background-color: transparent;
  border-width: 0;
  padding: 0;
  margin: 0;
  color: #4da3ff;
  -unity-font-style: bold;
}

.text-link:hover {
  color: #80c0ff;
}

.ft-login .unity-text-field:focus {
  border-width: 0;
}

.fbt-form-row.ft-login__field > .unity-base-field__label,
.ft-login__button {
  white-space: normal;
}

#main-view.lobby--short
  .fbt-form-row.ft-login__field
  > .unity-base-field__input {
  padding: 8px 10px;
}

#login-panel .ft-login__buttons {
  flex-direction: column;
}
.ft-login__buttons > .fbt-btn {
  margin-left: 0;
  font-size: 22px;
}
.fbt-form-row.ft-login__field.unity-text-field > .unity-base-field__label {
  width: auto;
}
#main-view.lobby--short
  .fbt-form-row.ft-login__field.unity-text-field
  > .unity-base-field__label {
  width: 48%;
}
#main-view.narrow-screen .ft-login .fbt-card-title {
  font-size: 27px;
  padding-left: 16px;
  padding-right: 16px;
}
#main-view.lobby--short .ft-login .fbt-card-header {
  height: 42px;
  min-height: 42px;
}
#main-view.lobby--short .ft-login .fbt-card-title {
  font-size: 26px;
  padding-top: 4px;
  padding-bottom: 4px;
}
