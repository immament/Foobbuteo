@import url("Theme.style.uss");

/* Reusable Foobbuteo components. Feature styles own placement and responsive sizing. */
.fbt-card {
  border-width: 1px;
  border-color: var(--fbt-panel-border);
  border-radius: 4px;
  overflow: hidden;
  color: var(--fbt-text);
  -unity-font-definition: var(--fbt-font-body);
  -unity-font-style: normal;
}

.fbt-card-header {
  flex-direction: row;
  align-items: stretch;
  height: var(--fbt-header-height);
  min-height: var(--fbt-header-height);
  flex-shrink: 0;
  background-color: #e9edf3;
  background-image: url("Images/FbtCardHeader.svg");
  background-size: 100% 100%;
}

.fbt-card-title {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
  margin: 0;
  padding: 7px 28px;
  color: #111d2f;
  -unity-font-definition: var(--fbt-font-heading);
  font-size: 32px;
  -unity-text-align: middle-left;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fbt-card-close {
  width: 64px;
  min-width: 64px;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  border-width: 1px;
  border-color: #3b91ff;
  border-radius: 0;
  background-color: #005bf0;
  align-items: center;
  justify-content: center;
}

.fbt-card-close:hover:enabled {
  background-color: #1674ff;
}

.fbt-card-close:active:enabled {
  background-color: #0047c4;
}

.fbt-card-close:focus:enabled {
  border-color: var(--fbt-focus);
}

.fbt-card-close:disabled {
  opacity: 0.45;
}

.fbt-card-close-icon {
  width: 36px;
  height: 36px;
  background-image: url("Images/FbtClose.svg");
  background-size: contain;
}

.fbt-card-content {
  min-height: 0;
  flex-shrink: 1;
  background-color: var(--fbt-panel-background);
}

.fbt-card-decoration {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  bottom: 0;
  background-image: url("Images/FbtCardStripes.svg");
  background-size: 100% 100%;
}

.fbt-card-body {
  min-height: 0;
  flex-shrink: 1;
  padding: 8px 22px 0;
}

.fbt-card-footer {
  flex-direction: row;
  justify-content: flex-end;
  flex-shrink: 0;
  padding: 12px 22px 16px;
}

.fbt-card-footer > .fbt-btn {
  margin-left: 12px;
}

.fbt-form-row {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  min-height: 47px;
  margin: 0;
  padding: 7px 0;
  border-bottom-width: 1px;
  border-bottom-color: var(--fbt-divider);
}

.fbt-form-label,
.fbt-form-row > .unity-base-field__label {
  width: 48%;
  min-width: 0;
  flex-shrink: 0;
  margin: 0;
  padding: 0 12px 0 0;
  color: var(--fbt-text-muted);
  -unity-font-definition: var(--fbt-font-body);
  -unity-font-style: normal;
  font-size: 18px;
  white-space: normal;
  -unity-text-align: middle-left;
}

.fbt-form-control-group {
  flex-direction: row;
  align-items: center;
  flex-grow: 1;
  min-width: 0;
}

.fbt-form-select {
  min-width: 0;
  margin: 0;
  flex-grow: 1;
}

.fbt-form-select > .unity-base-popup-field__input {
  min-width: 0;
  min-height: 32px;
  margin: 0;
  padding: 2px 11px;
  border-width: 1px;
  border-color: var(--fbt-field-border);
  border-radius: 4px;
  background-color: var(--fbt-field-background);
  color: var(--fbt-text);
}

.fbt-form-select:hover:enabled > .unity-base-popup-field__input {
  border-color: #88a6cc;
}

.fbt-form-select:focus:enabled > .unity-base-popup-field__input {
  border-color: var(--fbt-focus);
}

.fbt-form-select .unity-base-popup-field__text {
  min-width: 0;
  margin: 0;
  padding: 0;
  -unity-font-definition: var(--fbt-font-body);
  -unity-font-style: normal;
  font-size: 18px;
  -unity-text-align: middle-left;
}

.fbt-form-select .unity-base-popup-field__arrow {
  -unity-background-image-tint-color: var(--fbt-text);
}

.fbt-form-input > .unity-base-field__input {
  min-width: 0;
  margin: 0;
  padding: 4px 11px;
  border-width: 1px;
  border-color: var(--fbt-field-border);
  border-radius: 4px;
  background-color: var(--fbt-field-background);
  color: var(--fbt-text);
  font-size: 18px;
}
.fbt-form-input:hover:enabled > .unity-base-field__input {
  border-color: #88a6cc;
}
.fbt-form-input:focus:enabled > .unity-base-field__input {
  border-color: var(--fbt-focus);
}

.fbt-form-swatch {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
  margin-right: 9px;
  border-width: 1px;
  border-color: #bdc9da;
  border-radius: 3px;
}

.fbt-btn {
  min-height: 46px;
  flex-shrink: 0;
  margin: 0;
  padding: 5px 24px;
  border-width: 1px;
  border-radius: 4px;
  -unity-font-definition: var(--fbt-font-button);
  -unity-font-style: normal;
  font-size: 25px;
  -unity-text-align: middle-center;
}

.fbt-btn-solid {
  background-color: var(--fbt-button-background);
  border-color: var(--fbt-button-border);
  color: var(--fbt-button-text);
}

.fbt-btn-solid:hover:enabled,
.fbt-btn-outline:hover:enabled {
  background-color: var(--fbt-button-hover);
  color: var(--fbt-button-text);
}

.fbt-btn-solid:active:enabled,
.fbt-btn-outline:active:enabled {
  background-color: var(--fbt-button-active);
}

.fbt-btn-outline {
  background-color: transparent;
  border-color: var(--fbt-button-border);
  color: var(--fbt-button-border);
}

.fbt-btn:focus:enabled {
  border-color: var(--fbt-focus);
}

.fbt-btn:disabled {
  opacity: 0.45;
}

.fbt-btn-icon-right {
  padding-left: 48px;
  padding-right: 48px;
}

.fbt-btn-icon {
  position: absolute;
  right: 14px;
  top: 50%;
  translate: 0 -50%;
  width: 30px;
  height: 30px;
  background-image: url("Images/FbtChevronRight.svg");
  background-size: contain;
  -unity-background-image-tint-color: var(--fbt-button-text);
}

/* Buttons */
.connection-status {
  position: absolute;
  top: 10px;
  right: 10px;
  flex-direction: row;
  align-items: center;
  padding: 6px 10px;
  background-color: rgba(20, 24, 32, 0.99);
  color: rgb(240, 245, 255);
  border-radius: 6px;
  border-width: 1px;
  border-color: rgb(240, 70, 70);
}

.connection-status__dot {
  color: rgb(240, 70, 70);
  margin-right: 6px;
}

.btn-default {
  margin: 0;
  padding: 6px 10px;
  background-color: rgb(38, 53, 69);
  color: var(--text-color);
  border-radius: 8px;
  border-width: 1px;
  border-color: var(--panel-border);
  font-size: 14px;
}

.btn-default:hover {
  background-color: rgb(53, 73, 94);
  scale: 1.02;
}

.btn-default:focus {
  border-color: var(--accent);
}

.btn-default:active {
  background-color: rgb(64, 91, 118);
}

.btn-default:disabled {
  opacity: 0.45;
}

.btn-icon {
  width: 16px;
  height: 16px;
  -unity-background-scale-mode: scale-to-fit;
  background-color: transparent;
  border-width: 0;
}

.btn-icon:disabled {
  opacity: 0.2;
}
.btn-icon:hover {
  opacity: 0.6;
  scale: 1.02;
  background-color: rgba(20, 20, 20, 0.3);
}

.btn-sm {
  padding: 5px 8px;
  border-radius: 4px;
  min-width: auto;
  min-height: auto;
}

/* Alerts */

#toast-container {
  position: absolute;
  bottom: 50px;
  left: 16px;
  right: 16px;
  align-items: center;
}

.toast-alert {
  flex-shrink: 0;
  margin-top: 8px;
  background-color: rgba(0, 0, 0, 0.9);
  padding: 12px 16px;
  border-radius: 10px;
  border-width: 1px;
  border-color: rgb(52, 66, 82);
  color: rgb(243, 246, 250);
  font-size: 16px;
  max-height: 100px;
  max-width: 100%;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  /* padding: 10px 20px; */
  /* border-radius: 20px; */
}

#banner-container {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  translate: 0 -50%;
  align-items: center;
}

.banner-alert {
  opacity: 0;
  scale: 0.8 0.8;
  background-color: rgba(17, 24, 32, 0.95);
  border-radius: 12px;
  padding: 16px 24px;
  transition-duration: 0.3s;
  font-size: 32px;
  -unity-font-style: bold;
  color: rgb(243, 246, 250);
  -unity-text-align: middle-center;
  white-space: normal;
}

.banner-alert--visible {
  opacity: 1;
  scale: 1 1;
}
