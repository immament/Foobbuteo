/* Buttons */
.connection-status {
  position: absolute;
  top: 10px;
  right: 10px;
  flex-direction: row;
  align-items: center;
  padding: 6px 10px;
  background-color: rgba(20, 24, 32, 0.99);
  color: rgb(240, 245, 255);
  border-radius: 6px;
  border-width: 1px;
  border-color: rgb(240, 70, 70);
}

.connection-status__dot {
  color: rgb(240, 70, 70);
  margin-right: 6px;
}

.btn-default {
  margin: 0;
  padding: 6px 10px;
  background-color: rgb(38, 53, 69);
  color: var(--text-color);
  border-radius: 8px;
  border-width: 1px;
  border-color: var(--panel-border);
  font-size: 14px;
}

.btn-default:hover {
  background-color: rgb(53, 73, 94);
  scale: 1.02;
}

.btn-default:focus {
  border-color: var(--accent);
}

.btn-default:active {
  background-color: rgb(64, 91, 118);
}

.btn-default:disabled {
  opacity: 0.45;
}

.btn-icon {
  width: 16px;
  height: 16px;
  -unity-background-scale-mode: scale-to-fit;
  background-color: transparent;
  border-width: 0;
}

.btn-icon:disabled {
  opacity: 0.2;
}
.btn-icon:hover {
  opacity: 0.6;
  scale: 1.02;
  background-color: rgba(20, 20, 20, 0.3);
}

.btn-sm {
  padding: 5px 8px;
  border-radius: 4px;
  min-width: auto;
  min-height: auto;
}

/* Alerts */

#toast-container {
  position: absolute;
  bottom: 50px;
  left: 16px;
  right: 16px;
  align-items: center;
}

.toast-alert {
  flex-shrink: 0;
  margin-top: 8px;
  background-color: rgba(0, 0, 0, 0.9);
  padding: 12px 16px;
  border-radius: 10px;
  border-width: 1px;
  border-color: rgb(52, 66, 82);
  color: rgb(243, 246, 250);
  font-size: 16px;
  max-height: 100px;
  max-width: 100%;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  /* padding: 10px 20px; */
  /* border-radius: 20px; */
}

#banner-container {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  translate: 0 -50%;
  align-items: center;
}

.banner-alert {
  opacity: 0;
  scale: 0.8 0.8;
  background-color: rgba(17, 24, 32, 0.95);
  border-radius: 12px;
  padding: 16px 24px;
  transition-duration: 0.3s;
  font-size: 32px;
  -unity-font-style: bold;
  color: rgb(243, 246, 250);
  -unity-text-align: middle-center;
  white-space: normal;
}

.banner-alert--visible {
  opacity: 1;
  scale: 1 1;
}
