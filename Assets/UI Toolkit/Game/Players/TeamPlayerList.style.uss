.team-player-list__panel {
  color: rgb(243, 246, 250);
  font-size: 16px;
  width: 94%;
  max-height: 90%;
  max-width: 1360px;
  padding: 12px;
  background-color: rgb(28, 38, 50);
  border-width: 1px;
  border-color: rgb(99, 173, 255);
  border-radius: 8px;
}
.team-player-list__header {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-bottom: 8px;
}
.team-player-list__title {
  flex-grow: 1;
  flex-shrink: 1;
  font-size: 20px;
  -unity-font-style: bold;
}
.team-player-list__table {
  flex-shrink: 1;
  min-height: 0;
}
