<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="player-table" src="PlayerTable.tmpl.uxml" />
    <ui:Style src="TeamPlayerList.style.uss" />
    <ui:VisualElement name="team-player-list-panel" class="team-player-list__panel" picking-mode="Position" data-source-type="Imma.Foobbuteo.Client.Game.UI.Players.PlayerListVM, Foobbuteo.ClientLib">
        <ui:VisualElement class="team-player-list__header">
            <ui:Label name="team-player-list-title" class="team-player-list__title" enable-rich-text="false">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="Title" binding-mode="ToTarget" update-trigger="OnSourceChanged" />
                </Bindings>
            </ui:Label>
            <ui:Button name="team-player-list-close" text="Close" class="btn-default" />
        </ui:VisualElement>
        <ui:Instance template="player-table" class="team-player-list__table" />
    </ui:VisualElement>
</ui:UXML>
