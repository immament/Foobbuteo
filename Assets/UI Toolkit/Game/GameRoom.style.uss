:root {
  --panel-bg: var(--fbt-panel-background);
  --panel-border: var(--fbt-panel-border);
  --text-color: var(--fbt-text);
  --muted: var(--fbt-text-muted);
  --accent: var(--fbt-focus);
}

#game-room-root {
  color: var(--fbt-text);
  -unity-font-definition: var(--fbt-font-body);
  -unity-font-style: normal;
}

#MainLayout {
  flex-grow: 1;
  height: 100%;
  width: 100%;
  color: var(--text-color);
  font-size: 16px;
}

#unsafe-area-masks .unsafe-area-mask {
  position: absolute;
  background-color: rgb(17, 24, 32);
}

#UnsafeAreaTop {
  left: 0;
  right: 0;
  top: 0;
}

#UnsafeAreaRight {
  right: 0;
  top: 0;
  bottom: 0;
}

#UnsafeAreaBottom {
  left: 0;
  right: 0;
  bottom: 0;
}

#UnsafeAreaLeft {
  left: 0;
  top: 0;
  bottom: 0;
}

#SafeAreaRoot {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

#GameScreen {
  flex-grow: 1;
  flex-direction: row;
}

#LeftSide {
  flex-grow: 1;
}

#MainHeader {
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
  background-color: rgb(17, 24, 32);
  padding: 8px 0 8px 8px;
}
/* #MainHeader #GameCloseButton, */
#MainHeader #HelpButton {
  /* min-width: 44px;
  min-height: 44px; */
  -unity-font-definition: var(--fbt-font-button);
  -unity-font-style: normal;
  color: var(--fbt-button-text);
  font-size: 28px;
  padding: 0;
  min-height: 0;
  aspect-ratio: 1;
}

#MainHeader #ResultPanel {
  flex-direction: row;
  align-items: stretch;
  flex-grow: 1;
  flex-basis: 0;
  min-width: 0;
  /* padding: 1px 12px; */
  /* margin: 0 8px; */
  color: #111d2f;
}

#MainHeader .team-name {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  min-width: 0;
  font-size: 16px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  -unity-font-style: bold;
}

#MainHeader #TeamAName {
  -unity-text-align: middle-right;
}

#MainHeader #TeamBName {
  -unity-text-align: middle-left;
}

#MainHeader .team-color {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  align-self: center;
}

#MainHeader #Result {
  flex-shrink: 0;
  font-size: 28px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

#RightSide {
  flex-shrink: 0;
  width: 336px;
  background-color: rgb(17, 24, 32);
  padding: 8px;
}

#StatusPanel,
#MessagePanel {
  padding: 0;
}
#StatusPanel {
  padding: 8px 16px;
  padding-bottom: 8px;
  margin-bottom: 8px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

#StatusPanel.timer-urgent {
  border-color: rgb(247, 189, 88);
  border-width: 2px;
  padding: 7px 15px;
}

#StatusCell {
  flex-shrink: 0;
}

#TurnText {
  color: var(--muted);
  font-size: 14px;
}

#PhaseText {
  font-size: 16px;
  -unity-font-style: bold;
  white-space: normal;
  flex-shrink: 1;
}

#StatusPanel.timer-urgent #PhaseText {
  color: rgb(247, 189, 88);
}

#PitchArea {
  flex-grow: 1;
  min-height: 0;
  position: relative;
}

#PitchContainer {
  flex-grow: 1;
  min-height: 0;
}

#MainLayout.fixed-pitch-layout #LeftSide {
  flex-grow: 0;
  flex-shrink: 1;
  min-width: 0;
}

#MainLayout.fixed-pitch-layout #RightSide {
  flex-grow: 1;
}

#PitchBottomMask {
  display: none;
}

#RotateDeviceMessage {
  display: none;
}

#SidePanel {
  flex-grow: 1;
  min-height: 0;
}

#ActionsContainerTemplate {
  flex-shrink: 0;
}

#MessagePanel {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  min-height: 0;
  margin-top: 8px;
}

#MatchReportHeading {
  font-size: 14px;
  -unity-font-style: bold;
  color: var(--muted);
  margin-bottom: 8px;
  flex-shrink: 0;
}

#MatchReportScroll {
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 0;
}

#MatchReportScroll .unity-scroll-view__content-container {
  justify-content: flex-start;
}

.match-report-row {
  flex-direction: row;
  flex-shrink: 0;
  padding: 0 0;
  color: var(--text-color);
  font-size: 14px;
  align-items: flex-start;
}

.match-report-turn,
.match-report-number {
  flex-shrink: 0;
  margin-right: 4px;
  color: var(--muted);
  font-size: 16px;
}

.match-report-turn {
  width: 24px;
}

.match-report-marker {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  margin-top: 5px;
  margin-right: 2px;
}

.match-report-text {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  min-width: 0;
  white-space: normal;
}

#RotateDeviceMessageLabel {
  font-size: 14px;
  color: var(--muted);
  white-space: normal;
}

#SelectedPlayerPopup {
  position: absolute;
  display: none;
  padding-bottom: 12px;
}

#ActionsScroll {
  flex-shrink: 0;
}

#MainLayout .unity-label {
  margin-top: 0;
  margin-bottom: 0;
}

#MainLayout #MatchReportHeading {
  margin-bottom: 8px;
}

#MainLayout.compact-landscape #RightSide {
  width: 312px;
}

#MainLayout.compact-landscape #MessagePanel > .fbt-card-body {
  padding: 8px 12px;
}
#MainLayout.compact-landscape #StatusPanel {
  padding-left: 12px;
  padding-right: 12px;
}

#MainLayout.compact-landscape #StatusPanel.timer-urgent {
  padding: 7px 11px;
}

/* .short-landscape */

#MainLayout.short-landscape #ActionsScroll {
  max-height: 124px;
}

#MainLayout.short-landscape #StatusPanel {
  padding: 8px;
}

#MainLayout.short-landscape #StatusPanel.timer-urgent {
  padding: 7px;
}

#MainLayout.short-landscape #MessagePanel > .fbt-card-body {
  padding: 4px 8px;
}

/* .compact-header */
#MainLayout.compact-header #MainHeader {
  display: none;
}

#MainLayout.compact-header #pitch-match-overlay {
  display: flex;
}

/* .stacked-layout */

#MainLayout.stacked-layout #GameScreen {
  flex-direction: column;
}

#MainLayout.stacked-layout #RightSide {
  width: 100%;
  padding: 8px;
}

#MainLayout.stacked-layout #MessagePanel {
  min-height: 80px;
}

#MainLayout.stacked-layout #MatchReportHeading {
  display: none;
}

#MainLayout.stacked-layout #StatusPanel,
#MainLayout.stacked-layout #MessagePanel > .fbt-card-body,
#MainLayout.stacked-layout #ActionsContainer #BoxWithBackground {
  padding: 4px 8px;
}

#MainLayout.stacked-layout #StatusPanel.timer-urgent {
  padding: 3px 7px;
}

/* .portrait-screen */

#MainLayout.portrait-screen #RotateDeviceMessage {
  position: absolute;
  left: 50%;
  bottom: 10px;
  translate: -50% 0;
  display: flex;
  flex-shrink: 0;
  padding: 10px;
  align-items: center;
  background-color: rgb(17, 24, 32);
  border-radius: 8px;
}

#MainLayout.portrait-screen .side-score {
  font-size: 24px;
}
#MainLayout.portrait-screen #MainHeader .team-color {
  display: none;
}

.room-settings-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  min-height: 26px;
}

.room-user-tabs > .fbt-btn.user-tab-selected {
  background-color: var(--fbt-button-background);
  color: var(--fbt-button-text);
}
.mvm-join-panel {
  display: none;
  margin: 8px;
  padding: 8px;
}

.mvm-join-panel__error {
  color: rgb(240, 110, 110);
  white-space: normal;
}

#pitch-match-overlay {
  display: none;
  position: absolute;
  top: 2px;
  left: 6px;
  right: 6px;
  flex-direction: row;
  align-items: flex-start;
  /* padding: 6px; */
}

#pitch-scoreboard {
  flex-direction: row;
  flex-shrink: 1;
  min-width: 0;
  align-items: center;
}

.pitch-scoreboard__team {
  flex-direction: row;
  flex-shrink: 1;
  min-width: 0;
  height: 24px;
  align-items: stretch;
}

#pitch-away-team {
  margin-left: 4px;
}

.pitch-scoreboard__name {
  flex-shrink: 1;
  min-width: 0;
  max-width: 160px;
  padding: 0 8px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 14px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

.pitch-scoreboard__name:hover,
.pitch-scoreboard__name:focus {
  background-color: rgba(0, 0, 0, 0.35);
  color: #fff;
}

.pitch-scoreboard__score {
  flex-shrink: 0;
  min-width: 28px;
  padding: 0 6px;
  font-size: 14px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  border-color: rgba(255, 255, 255, 0.35);
}

#pitch-home-score {
  border-left-width: 1px;
}

#pitch-away-score {
  border-right-width: 1px;
}

#pitch-header-controls {
  flex-direction: row;
  flex-shrink: 0;
  margin-left: auto;
  padding-left: 6px;
}

.fbt-btn.lineup-editor__open {
  display: none;
  flex-shrink: 0;
  padding: 0;
  background-image: url("Players/EditLineup.svg");
  background-size: 18px 22px;
  align-self: center;
  /* -unity-background-scale-mode: scale-to-fit; */
}
#MainHeader .fbt-btn.lineup-editor__open {
  width: 32px;
  height: 32px;
  min-width: 24px;
  min-height: 24px;
}

#pitch-scoreboard .lineup-editor__open {
  width: 28px;
  min-width: 28px;
  background-size: 16px 20px;
  padding: 0;
}

#pitch-match-overlay .fbt-btn {
  min-height: 24px;
  font-size: 18px;
  margin: 0;
  height: 24px;
  min-width: 24px;
  padding: 0;
  border-radius: 4px;
  opacity: 0.6;
}
#pitch-match-overlay .fbt-btn:hover {
  opacity: 1;
}

#pitch-match-overlay #pitch-close-button {
  margin-left: 4px;
  padding-bottom: 2px;
  /* padding-left: 1px; */
}

.room-user-tabs > .fbt-btn {
  min-height: 30px;
  padding: 2px 10px;
  font-size: 18px;
  background-color: transparent;
  color: #111d2f;
  margin-right: 4px;
}
#MessagePanel > .room-settings-row {
  padding-left: 8px;
}
#MessagePanel > .fbt-card-body {
  flex-grow: 1;
  padding: 8px 12px;
}
#open-settings-btn {
  background-image: url("SettingsGear.svg");
  /* min-width: 40px;
  min-height: 40px; */
  padding: 0;
  background-size: 22px 22px;
  background-position: center;
  background-repeat: no-repeat;
}

#game-room-root .user-list-name,
#game-room-root .match-report-row,
#game-settings-panel .sound-volume-title,
#game-settings-panel #sound-volume-label,
.lineup-editor__instructions,
.lineup-editor__touch-instructions,
.lineup-editor__error,
.lineup-editor .player-table__cell {
  -unity-font-style: normal;
}
