#help-panel .unity-tab__header {
  background-color: var(--fbt-field-background);
  color: var(--fbt-text-muted);
  -unity-font-style: bold;
  font-size: 16px;
  padding: 10px 16px;
  border-radius: 4px 4px 0 0;
}

#help-panel .unity-tab__header:checked {
  background-color: var(--fbt-button-background);
  color: var(--fbt-button-text);
}

#help-panel .unity-tab__header:hover {
  background-color: var(--fbt-button-hover);
}

#help-panel .unity-tab__header-underline {
  opacity: 0;
}

#help-panel .help-item {
  flex-direction: row;
  margin-top: 20px;
  margin-bottom: 10px;
}

#help-panel .help-item #image {
  width: 64px;
  height: 64px;
  margin-right: 12px;
}

#help-panel .help-item #title {
  font-size: 16px;
  -unity-font-style: bold;
  white-space: pre-wrap;
}

#help-panel .help-item #description {
  font-size: 16px;
  white-space: pre-wrap;
}

#HelpScreen {
  padding: 10px 15px;
}

.popup-container {
  align-self: center;
  width: 90%;
  height: 90%;
  align-items: stretch;
}

.help-panel__content,
#help-panel #TabView {
  flex-grow: 1;
  min-height: 0;
}
