#TooltipRoot {
  position: absolute;
  background-color: var(--fbt-field-background);
  border-width: 1px;
  border-color: var(--fbt-panel-border);
  -unity-font-definition: var(--fbt-font-body);
  -unity-font-style: normal;
  padding-left: 8px;
  padding-right: 8px;
  padding-top: 4px;
  padding-bottom: 4px;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
  border-bottom-left-radius: 6px;
  border-bottom-right-radius: 6px;
  display: none;
  max-width: 500px;
}

#TitleLabel {
  -unity-font-definition: var(--fbt-font-heading);
  font-size: 20px;
  color: var(--fbt-text);
  max-width: 100%;
  white-space: normal;
}

#DescriptionLabel {
  font-size: 16px;
  color: var(--fbt-text);
  white-space: normal;
  -unity-paragraph-spacing: 24px;
}
