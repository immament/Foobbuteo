<ui:UXML xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="ActionsContainer" src="project://database/Assets/UI%20Toolkit/Game/GameActionsContainer.tmpl.uxml?fileID=9197481963319205126&amp;guid=dbdd8ab1dfcb38146905eeb4b67e2d39&amp;type=3#GameActionsContainer.tmpl"/>
    <ui:Template name="game-settings" src="project://database/Assets/UI%20Toolkit/Game/GameSettings.tmpl.uxml?fileID=9197481963319205126&amp;guid=dd4ad2d5b163f244a9d868a17143cab9&amp;type=3#GameSettings.tmpl"/>
    <ui:Template name="help" src="project://database/Assets/UI%20Toolkit/Game/Help.tmpl.uxml?fileID=9197481963319205126&amp;guid=67462bb5d81e4864f8f8a78871b73b28&amp;type=3#Help.tmpl"/>
    <ui:Template name="mvm-lineup" src="project://database/Assets/UI%20Toolkit/Game/Players/MvMLineup.tmpl.uxml?fileID=9197481963319205126&amp;guid=5a86e61ee13aa9d4d8df78c734f9b7c6&amp;type=3#MvMLineup.tmpl"/>
    <ui:Template name="room-user-list" src="project://database/Assets/UI%20Toolkit/Users/UserListView.tmpl.uxml?fileID=9197481963319205126&amp;guid=f137e80d677dc5a45b6c976d18ade83e&amp;type=3#UserListView.tmpl"/>
    <ui:Template name="team-player-list" src="project://database/Assets/UI%20Toolkit/Game/Players/TeamPlayerList.tmpl.uxml?fileID=9197481963319205126&amp;guid=9a737d8813f34f94c8b7cae320b1705f&amp;type=3#TeamPlayerList.tmpl"/>
    <Style src="project://database/Assets/UI%20Toolkit/Users/UserLists.style.uss?fileID=7433441132597879392&amp;guid=a663d49976fadf84eb861b1f86906ec6&amp;type=3#UserLists.style"/>
    <Style src="project://database/Assets/UI%20Toolkit/Game/GameRoom.style.uss?fileID=7433441132597879392&amp;guid=a988cd52bfa4d2f418d091682b2dc080&amp;type=3#GameRoom.style"/>
    <Style src="project://database/Assets/UI%20Toolkit/Common.style.uss?fileID=7433441132597879392&amp;guid=8361f49c9922b6142ac6723225d1e4a1&amp;type=3#Common.style"/>
    <Style src="project://database/Assets/UI%20Toolkit/Game/Players/MvMLineup.style.uss?fileID=7433441132597879392&amp;guid=13c470010e05e7e41b331fd37636a6c7&amp;type=3#MvMLineup.style"/>
    <Style src="project://database/Assets/UI%20Toolkit/Modals/ModalHost.style.uss?fileID=7433441132597879392&amp;guid=c398f029bf3cf594794053a1320cefe0&amp;type=3#ModalHost.style"/>
    <ui:VisualElement name="game-room-root" picking-mode="Ignore" class="fbt-theme-primary">
        <ui:VisualElement name="unsafe-area-masks" picking-mode="Ignore">
            <ui:VisualElement name="UnsafeAreaTop" picking-mode="Position" class="unsafe-area-mask"/>
            <ui:VisualElement name="UnsafeAreaRight" picking-mode="Position" class="unsafe-area-mask"/>
            <ui:VisualElement name="UnsafeAreaBottom" picking-mode="Position" class="unsafe-area-mask"/>
            <ui:VisualElement name="UnsafeAreaLeft" picking-mode="Position" class="unsafe-area-mask"/>
        </ui:VisualElement>
        <ui:VisualElement name="screen-content" picking-mode="Ignore">
            <ui:VisualElement name="MainLayout" data-source="project://database/Assets/UI%20Toolkit/Game/GameHudVMData.asset?fileID=11400000&amp;guid=03084d53eb9aaf549a1a41e0a2647c0f&amp;type=2#GameHudVMData" data-source-type="Imma.Foobbuteo.Client.Game.UI.VM.GameHudVM, Foobbuteo.ClientLib" picking-mode="Ignore">
                <ui:VisualElement name="SafeAreaRoot" picking-mode="Ignore">
                    <ui:VisualElement name="GameScreen" picking-mode="Ignore">
                        <ui:VisualElement name="LeftSide" picking-mode="Ignore">
                            <ui:VisualElement name="MainHeader" picking-mode="Ignore">
                                <ui:VisualElement name="ResultPanel" class="fbt-card-header">
                                    
                                    <ui:Label name="TeamAName" text="Team A" class="team-name">
                                        <Bindings>
                                            <ui:DataBinding property="text" data-source-path="TeamA.Name" binding-mode="ToTarget"/>
                                            <ui:DataBinding property="tooltip" data-source-path="TeamA.Name" binding-mode="ToTarget"/>
                                        </Bindings>
                                    </ui:Label>
                                    <ui:Button name="home-edit-lineup" tooltip="Edit lineup" class="fbt-btn fbt-btn-solid fbt-theme-primary lineup-editor__open">
                                        <Bindings>
                                            <ui:DataBinding property="style.display" data-source-path="HomeDisplay" binding-mode="ToTarget" update-trigger="OnSourceChanged"/>
                                        </Bindings>
                                    </ui:Button>
                                    <ui:Image name="TeamAColor" class="team-color">
                                        <Bindings>
                                            <ui:DataBinding property="style.backgroundImage" data-source-path="TeamA.Logo" binding-mode="ToTarget"/>
                                        </Bindings>
                                    </ui:Image>
                                    <ui:Label name="Result" text="0:0" class="result">
                                        <Bindings>
                                            <ui:DataBinding property="text" data-source-path="ScoreText" binding-mode="ToTarget"/>
                                        </Bindings>
                                    </ui:Label>
                                    <ui:Image name="TeamBColor" class="team-color">
                                        <Bindings>
                                            <ui:DataBinding property="style.backgroundImage" data-source-path="TeamB.Logo" binding-mode="ToTarget"/>
                                        </Bindings>
                                    </ui:Image>
                                    <ui:Button name="away-edit-lineup" tooltip="Edit lineup" class="fbt-btn fbt-btn-solid fbt-theme-primary lineup-editor__open">
                                        <Bindings>
                                            <ui:DataBinding property="style.display" data-source-path="AwayDisplay" binding-mode="ToTarget" update-trigger="OnSourceChanged"/>
                                        </Bindings>
                                    </ui:Button>
                                    <ui:Label name="TeamBName" text="Team B" class="team-name">
                                        <Bindings>
                                            <ui:DataBinding property="text" data-source-path="TeamB.Name" binding-mode="ToTarget"/>
                                            <ui:DataBinding property="tooltip" data-source-path="TeamB.Name" binding-mode="ToTarget"/>
                                        </Bindings>
                                    </ui:Label>
                                    <ui:Button name="HelpButton" text="?" tooltip="Help" class="fbt-card-header-btn"/>
                                    <ui:Button name="GameCloseButton" class="fbt-card-close">
                                        <ui:VisualElement class="fbt-card-close-icon" picking-mode="Ignore" />
                                        <Bindings>
                                            <ui:DataBinding property="style.display" data-source-path="CloseButtonDisplay" binding-mode="ToTarget" update-trigger="OnSourceChanged"/>
                                        </Bindings>
                                    </ui:Button>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="PitchArea" picking-mode="Ignore">
                                <ui:VisualElement name="PitchContainer" picking-mode="Ignore"/>
                                <ui:VisualElement name="pitch-match-overlay" picking-mode="Ignore">
                                    <ui:VisualElement name="pitch-scoreboard" picking-mode="Ignore">
                                        <ui:Button name="mobile-home-edit-lineup" tooltip="Edit lineup" class="fbt-btn fbt-btn-solid fbt-theme-primary lineup-editor__open">
                                            <Bindings>
                                                <ui:DataBinding property="style.display" data-source-path="HomeDisplay" binding-mode="ToTarget" update-trigger="OnSourceChanged"/>
                                            </Bindings>
                                        </ui:Button>
                                        <ui:VisualElement name="pitch-home-team" picking-mode="Ignore" class="pitch-scoreboard__team">
                                            <Bindings>
                                                <ui:DataBinding property="style.backgroundColor" data-source-path="TeamA.ShirtBackgroundColor" binding-mode="ToTarget"/>
                                                <ui:DataBinding property="style.color" data-source-path="TeamA.ShirtTextColor" binding-mode="ToTarget"/>
                                            </Bindings>
                                            <ui:Label name="pitch-home-name" text="Home" class="pitch-scoreboard__name">
                                                <Bindings>
                                                    <ui:DataBinding property="text" data-source-path="TeamA.Name" binding-mode="ToTarget"/>
                                                    <ui:DataBinding property="tooltip" data-source-path="TeamA.Name" binding-mode="ToTarget"/>
                                                </Bindings>
                                            </ui:Label>
                                            <ui:Label name="pitch-home-score" text="0" picking-mode="Ignore" class="pitch-scoreboard__score">
                                                <Bindings>
                                                    <ui:DataBinding property="text" data-source-path="ScoreA" binding-mode="ToTarget"/>
                                                </Bindings>
                                            </ui:Label>
                                        </ui:VisualElement>
                                        <ui:VisualElement name="pitch-away-team" picking-mode="Ignore" class="pitch-scoreboard__team">
                                            <Bindings>
                                                <ui:DataBinding property="style.backgroundColor" data-source-path="TeamB.ShirtBackgroundColor" binding-mode="ToTarget"/>
                                                <ui:DataBinding property="style.color" data-source-path="TeamB.ShirtTextColor" binding-mode="ToTarget"/>
                                            </Bindings>
                                            <ui:Label name="pitch-away-score" text="0" picking-mode="Ignore" class="pitch-scoreboard__score">
                                                <Bindings>
                                                    <ui:DataBinding property="text" data-source-path="ScoreB" binding-mode="ToTarget"/>
                                                </Bindings>
                                            </ui:Label>
                                            <ui:Label name="pitch-away-name" text="Away" class="pitch-scoreboard__name">
                                                <Bindings>
                                                    <ui:DataBinding property="text" data-source-path="TeamB.Name" binding-mode="ToTarget"/>
                                                    <ui:DataBinding property="tooltip" data-source-path="TeamB.Name" binding-mode="ToTarget"/>
                                                </Bindings>
                                            </ui:Label>
                                        </ui:VisualElement>
                                        <ui:Button name="mobile-away-edit-lineup" tooltip="Edit lineup" class="fbt-btn fbt-btn-solid fbt-theme-primary lineup-editor__open">
                                            <Bindings>
                                                <ui:DataBinding property="style.display" data-source-path="AwayDisplay" binding-mode="ToTarget" update-trigger="OnSourceChanged"/>
                                            </Bindings>
                                        </ui:Button>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="pitch-header-controls" picking-mode="Ignore">
                                        <ui:Button name="pitch-help-button" text="?" tooltip="Help" class="fbt-btn fbt-btn-solid fbt-theme-primary"/>
                                        <ui:Button name="pitch-close-button" text="x" class="fbt-btn fbt-btn-solid fbt-theme-primary">
                                            <Bindings>
                                                <ui:DataBinding property="style.display" data-source-path="CloseButtonDisplay" binding-mode="ToTarget" update-trigger="OnSourceChanged"/>
                                            </Bindings>
                                        </ui:Button>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="RotateDeviceMessage" picking-mode="Ignore">
                                    <ui:Label name="RotateDeviceMessageLabel" text="Rotate device to play" picking-mode="Ignore"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="PitchBottomMask" picking-mode="Ignore"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="RightSide" picking-mode="Ignore">
                            <ui:VisualElement name="StatusCell">
                                <ui:VisualElement name="StatusPanel" class="fbt-card fbt-card-content">
                                    <ui:Label name="TurnText" text="Turn">
                                        <Bindings>
                                            <ui:DataBinding property="text" data-source-path="TurnText" binding-mode="ToTarget"/>
                                        </Bindings>
                                    </ui:Label>
                                    <ui:Label name="PhaseText" text="Timer">
                                        <Bindings>
                                            <ui:DataBinding property="text" data-source-path="TimerText" binding-mode="ToTarget"/>
                                        </Bindings>
                                    </ui:Label>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="SidePanel" picking-mode="Ignore">
                                <ui:VisualElement name="mvm-join-panel" class="mvm-join-panel fbt-card fbt-card-content">
                                    <Bindings>
                                        <ui:DataBinding property="style.display" data-source-path="Display" binding-mode="ToTarget" update-trigger="OnSourceChanged"/>
                                    </Bindings>
                                    <ui:DropdownField name="mvm-join-team" label="My team" class="fbt-form-row fbt-form-select">
                                        <Bindings>
                                            <ui:DataBinding property="choices" data-source-path="TeamChoices" binding-mode="ToTarget" update-trigger="OnSourceChanged"/>
                                            <ui:DataBinding property="index" data-source-path="SelectedTeamIndex" binding-mode="TwoWay" update-trigger="OnSourceChanged"/>
                                            <ui:DataBinding property="enabledSelf" data-source-path="InputsEnabled" binding-mode="ToTarget" update-trigger="OnSourceChanged"/>
                                        </Bindings>
                                    </ui:DropdownField>
                                    <ui:Button name="mvm-join-button" text="Join as away manager" class="fbt-btn fbt-btn-solid fbt-theme-primary">
                                        <Bindings>
                                            <ui:DataBinding property="enabledSelf" data-source-path="CanJoin" binding-mode="ToTarget" update-trigger="OnSourceChanged"/>
                                            <ui:DataBinding property="text" data-source-path="JoinText" binding-mode="ToTarget" update-trigger="OnSourceChanged"/>
                                        </Bindings>
                                    </ui:Button>
                                    <ui:Label name="mvm-join-error" class="mvm-join-panel__error">
                                        <Bindings>
                                            <ui:DataBinding property="text" data-source-path="Error" binding-mode="ToTarget" update-trigger="OnSourceChanged"/>
                                        </Bindings>
                                    </ui:Label>
                                </ui:VisualElement>
                                <ui:ScrollView name="ActionsScroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                                    <ui:Instance template="ActionsContainer" name="ActionsContainerTemplate" picking-mode="Ignore"/>
                                </ui:ScrollView>
                                <ui:VisualElement name="MessagePanel" picking-mode="Ignore" class="fbt-card fbt-card-content">
                                    <ui:VisualElement class="room-settings-row fbt-card-header">
                                        <ui:VisualElement class="room-user-tabs">
                                            <ui:Button name="messagesTabButton" text="Messages" class="fbt-btn fbt-btn-solid fbt-theme-primary fbt-btn-compact user-tab-selected"/>
                                            <ui:Button name="usersTabButton" text="Users" class="fbt-btn fbt-btn-solid fbt-theme-primary fbt-btn-compact"/>
                                        </ui:VisualElement>
                                        <ui:Button name="open-settings-btn" tooltip="Settings" class="fbt-card-header-btn"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="roomMessagesContent" class="fbt-card-body">
                                        <ui:Label name="MatchReportHeading" text="Match events"/>
                                        <ui:ScrollView name="MatchReportScroll" mode="Vertical" horizontal-scroller-visibility="Hidden"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="roomUsersContent" class="user-list-hidden fbt-card-body">
                                        <ui:Instance template="room-user-list" class="user-list-content"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="contextual-popup-layer" picking-mode="Ignore">
                <ui:VisualElement name="SelectedPlayerPopup">
                    <ui:Button text="Choose player" name="SelectedPlayerClaimBtn" class="fbt-btn fbt-btn-solid fbt-theme-primary"/>
                    <Bindings>
                        <ui:DataBinding property="style.display" data-source-path="CanClaimPlayer" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="modal-layer" picking-mode="Ignore">
            <ui:VisualElement name="modal-backdrop" picking-mode="Position"/>
            <ui:VisualElement name="modal-safe-area" picking-mode="Ignore">
                <ui:VisualElement name="modal-content" picking-mode="Ignore">
                    <ui:Instance template="help" name="help-modal" picking-mode="Ignore" class="modal-panel-host"/>
                    <ui:Instance template="game-settings" name="game-settings-overlay" picking-mode="Ignore" class="modal-panel-host"/>
                    <ui:Instance template="team-player-list" name="team-player-list-overlay" picking-mode="Ignore" class="modal-panel-host"/>
                    <ui:Instance template="mvm-lineup" name="mvm-lineup-overlay" picking-mode="Ignore" class="modal-panel-host"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="notifications-safe-area" picking-mode="Ignore">
            <ui:VisualElement name="toast-container" picking-mode="Ignore"/>
            <ui:VisualElement name="banner-container" picking-mode="Ignore"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
