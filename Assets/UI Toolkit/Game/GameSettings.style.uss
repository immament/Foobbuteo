#game-settings-panel {
  width: 90%;
  max-width: 420px;
  padding: 15px 20px;
  background-color: rgb(28, 38, 50);
  border-width: 1px;
  border-color: rgb(99, 173, 255);
  border-radius: 8px;
  color: rgb(243, 246, 250);
}
.game-settings-title {
  font-size: 24px;
  margin-bottom: 8px;
}
#sound-volume-slider {
  min-height: 32px;
  flex-shrink: 0;
}

#close-game-settings-btn {
  margin-top: 16px;
}

#dev-network-gui-toggle {
  margin-top: 12px;
  min-height: 32px;
  flex-shrink: 0;
}

/* #dev-network-gui-toggle .unity-toggle__text {
  margin-left: 10px;
}

#dev-network-gui-toggle .unity-toggle__checkmark {
 

} */

/* Switch track */
#dev-network-gui-toggle > .unity-toggle__input {
  width: 44px;
  height: 24px;
  min-width: 44px;
  flex-grow: 0;
  flex-shrink: 0;
  padding: 0;
  margin: 0;
  border-width: 0;
  border-radius: 12px;
  background-color: rgb(90, 100, 115);
  overflow: visible;

  transition-property: background-color;
  transition-duration: 0.15s;
}

/* Sliding thumb: replace the standard checkbox graphic */
#dev-network-gui-toggle .unity-toggle__checkmark {
  position: absolute;
  left: 3px;
  top: 3px;
  width: 18px;
  height: 18px;
  margin: 0;
  border-width: 0;
  border-radius: 9px;
  background-image: none;
  background-color: white;
  translate: 0 0;

  transition-property: translate;
  transition-duration: 0.15s;
}

/* Enabled state */
#dev-network-gui-toggle:checked > .unity-toggle__input {
  background-color: rgb(45, 160, 100);
}

#dev-network-gui-toggle:checked .unity-toggle__checkmark {
  translate: 20px 0;
}

/* Caption: 12px after the 44px track */
#dev-network-gui-toggle .unity-toggle__text {
  position: absolute;
  left: 56px;
  top: 0;
  height: 24px;
  margin: 0;
  white-space: nowrap;
  -unity-text-align: middle-left;
}

.game-settings__volume-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
